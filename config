ngx_addon_name=ngx_http_upstream_queue_module

if test "$ngx_module_link" != DYNAMIC; then

cat << END

$0: error: $ngx_addon_name can only be built as a dynamic
module: it includes src/http/ngx_http_upstream.c, so linking it into
nginx defines that file's symbols twice.  Use --add-dynamic-module
instead of --add-module.

END
    exit 1
fi

ngx_module_name=$ngx_addon_name
ngx_module_srcs=$ngx_addon_dir/ngx_http_upstream_queue_module.c
ngx_module_type=HTTP

. auto/module
